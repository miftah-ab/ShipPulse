# ============================================================
# ShipPulse — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:your_password@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ── GitHub OAuth App ─────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Callback URL: https://YOUR_SUPABASE_URL/auth/v1/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ── GitHub App / Webhook ─────────────────────────────────────
# Secret used to validate GitHub webhook signatures (sha256)
GITHUB_WEBHOOK_SECRET=your_random_webhook_secret_min_32_chars

# ── AI Providers ─────────────────────────────────────────────
# Primary: Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# Fallback: OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key
OPENROUTER_SITE_URL=https://shippulse.vercel.app
OPENROUTER_SITE_NAME=ShipPulse

# ── Email — Resend ───────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=updates@shippulse.vercel.app
RESEND_FROM_NAME=ShipPulse

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://shippulse.vercel.app
NEXT_PUBLIC_APP_NAME=ShipPulse
NEXT_PUBLIC_WIDGET_URL=https://shippulse.vercel.app/widget.js

# Used for signing invitation tokens, webhook delivery HMAC, etc.
APP_SECRET=your_random_app_secret_min_64_chars

# ── Rate Limiting ────────────────────────────────────────────
# Requests per minute per IP for public endpoints
RATE_LIMIT_PUBLIC_RPM=60
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_AI_RPM=10
RATE_LIMIT_WEBHOOK_RPM=30

# ── Billing (Stripe — optional, plug in when ready) ──────────
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
# STRIPE_PRICE_TEAM_MONTHLY=price_team_monthly_id

# ── Storage ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://YOUR_PROJECT_ID.supabase.co/storage/v1
SUPABASE_STORAGE_BUCKET_MEDIA=shippulse-media
SUPABASE_STORAGE_BUCKET_AVATARS=shippulse-avatars
MAX_UPLOAD_SIZE_BYTES=10485760

# ── Feature Flags ────────────────────────────────────────────
# Set to 'true' to enable; 'false' to show "not available" state
FEATURE_CUSTOM_DOMAINS=true
FEATURE_TEAM_MEMBERS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SLACK_INTEGRATION=true
FEATURE_DISCORD_INTEGRATION=true

# ── CRON / Scheduler ─────────────────────────────────────────
# Secret for Vercel Cron Job authentication
CRON_SECRET=your_random_cron_secret

# ── Analytics ────────────────────────────────────────────────
# Internal analytics uses the DB event model (no external provider required)
# To optionally add an external analytics provider later, add keys here.

# ── Development ──────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js
# Set to 'true' to enable verbose AI logging in development
AI_DEBUG_LOGGING=false
